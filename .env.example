# Backend Environment Configuration (Copy to .env)

# Port configuration (Render / Heroku / Local)
PORT=8000
FRONTEND_ORIGIN="*"

# Secret key for RBAC JWT tokens
AUTH_SECRET="heatwave-parametric-secret-key-2026"

# Supabase Credentials (Optional: Leave empty for local SQLite auto-fallback)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-role-key"

# Path for local SQLite fallback
PARAMETRIC_DB_PATH="data/parametric.db"
